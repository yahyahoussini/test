# -----------------------------------------------------------------------------
# WEB
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:4000/api
VITE_DEFAULT_LOCALE=ar-MA

# -----------------------------------------------------------------------------
# API
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=4000

# For local dev with Docker: postgresql://postgres:password@localhost:5432/bio_cosmetics_dev
DATABASE_URL="postgresql://postgres:password@localhost:5432/bio_cosmetics_dev?schema=public"

# For local dev with Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Generate a strong, random string for JWT signing (at least 32 characters)
JWT_SECRET="a-very-strong-super-secret-jwt-key-that-is-at-least-32-chars"
TOTP_ISSUER=TussnaAdmin

# Optional: Comma-separated list of IPs to allow for admin access.
# ADMIN_IP_ALLOWLIST=127.0.0.1,::1

# -----------------------------------------------------------------------------
# S3-Compatible Object Storage (e.g., Cloudflare R2, MinIO, AWS S3)
# -----------------------------------------------------------------------------
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# -----------------------------------------------------------------------------
# Notifications (choose one provider; 'log' is for development)
# -----------------------------------------------------------------------------
# SMS Provider ('log' | 'twilio' | 'other')
SMS_PROVIDER=log
SMS_FROM=TussnaBio
# For Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# WhatsApp Provider ('log' | 'meta' | 'other')
WHATSAPP_PROVIDER=log
# For Meta API
# WHATSAPP_FROM=
# WHATSAPP_API_TOKEN=
