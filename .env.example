# -----------------------------------------------------------------------------
# Example Environment Variables
#
# DO NOT COMMIT .env TO VERSION CONTROL.
# This file should be copied to .env and filled with your actual credentials.
# -----------------------------------------------------------------------------

# --- Application ---
# The environment the app is running in.
# NODE_ENV=development

# --- Web Frontend ---
# The base URL for the API. In development, this points to the local API server.
# In production, this should be the URL of your deployed backend.
VITE_API_BASE_URL=http://localhost:4000/api
VITE_DEFAULT_LOCALE=ar-MA
VITE_SENTRY_DSN=

# --- API Backend ---
# The port the API server will listen on.
PORT=4000

# Database URL (PostgreSQL)
# For local dev with Docker: postgresql://postgres:password@localhost:5432/bio_cosmetics
DATABASE_URL="postgresql://postgres:password@localhost:5432/bio_cosmetics?schema=public"

# Redis URL
# For local dev with Docker: redis://localhost:6379
REDIS_URL="redis://localhost:6379"

# Security
# Generate a strong, random string for JWT signing.
JWT_SECRET="your-super-secret-jwt-key"
# Used for TOTP issuer name (e.g., in Google Authenticator).
TOTP_ISSUER="BioCosmeticsAdmin"
# Optional: Comma-separated list of IPs to allow for admin access.
# ADMIN_IP_ALLOWLIST=

# --- S3-Compatible Object Storage (e.g., Cloudflare R2, MinIO, AWS S3) ---
# The endpoint of your S3-compatible storage service.
S3_ENDPOINT=
# Your access key ID.
S3_ACCESS_KEY_ID=
# Your secret access key.
S3_SECRET_ACCESS_KEY=
# The name of the bucket to use for storing media.
S3_BUCKET=
# The public-facing base URL for accessing files in the bucket.
# e.g., https://pub-xxxxxxxx.r2.dev
S3_PUBLIC_BASE_URL=

# --- Notification Services (Choose one provider per channel, or use 'log') ---
# 'log' will print messages to the console instead of sending them.
# This is useful for development.

# SMS Provider ('log' | 'twilio' | 'other')
SMS_PROVIDER=log
SMS_FROM=+15005550006 # A valid Twilio test number or your actual number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# WhatsApp Provider ('log' | 'meta' | 'other')
WHATSAPP_PROVIDER=log
WHATSAPP_FROM=
WHATSAPP_API_TOKEN=

# --- CORS ---
# Comma-separated list of allowed origins for CORS.
# In development, this should include your frontend's URL.
# e.g., http://localhost:5173,https://your-production-domain.com
CORS_ORIGIN=http://localhost:5173
