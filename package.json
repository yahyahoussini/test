{
  "name": "cod-ecommerce-mvp-morocco",
  "version": "1.0.0",
  "private": true,
  "description": "Production-Ready COD-Only E-Commerce MVP (Morocco · ar‑MA + fr‑MA)",
  "author": "Jules",
  "license": "MIT",
  "workspaces": [
    "api",
    "web",
    "shared"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=api & npm run dev --workspace=web",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspaces --if-present",
    "build:api": "npm run build --workspace=api",
    "build:web": "npm run build --workspace=web",
    "start:api": "npm start --workspace=api",
    "seed": "npm run seed --workspace=api",
    "migrate:dev": "npm run migrate:dev --workspace=api",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "8.2.2",
    "eslint": "8.57.0",
    "prettier": "3.2.5",
    "typescript": "5.4.5"
  }
}
