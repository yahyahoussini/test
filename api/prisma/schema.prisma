generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------
// ENUMS
// -------------------

enum OrderStatus {
  NEW
  VERIFYING
  CONFIRMED
  PACKED
  SHIPPED
  DELIVERED
  CANCELLED
  RTO // Returned to Origin
  NO_ANSWER
}

enum OrderSource {
  WEB
  WHATSAPP
}

// -------------------
// MODELS
// -------------------

model Product {
  id        String   @id @default(cuid())
  sku       String   @unique
  slug      String   @unique
  active    Boolean  @default(true)
  priceMAD  Float
  stock     Int      @default(0)
  images    String[]
  i18n      Json // e.g. { "ar-MA": { "name": "...", ... }, "fr-MA": { ... } }
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id         String      @id @default(cuid())
  shortId    String      @unique
  items      Json // Snapshot of items: [{ productId, sku, name, price, qty, image }]
  totals     Json // Snapshot of totals: { subtotal, shipping, codFee, grandTotal, currency }
  customer   Json // { name, phone, city, address, notes }
  status     OrderStatus @default(NEW)
  source     OrderSource @default(WEB)
  verification Json?     // { method: 'otp' | 'manual', otpAttemptCount, verifiedAt }
  timeline   Json[]      // Array of status changes: [{ status, timestamp, actor: 'system' | 'admin_id', note? }]
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Relation to OrderItem for better querying and inventory management
  orderItems OrderItem[]
}

// This model provides a structured way to link orders and products,
// which is better for analytics and inventory tracking than just a JSON blob.
model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id])
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceAtTime Float   // The price of the product when the order was placed

  @@unique([orderId, productId])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  totpSecret   String?
  roles        String[] @default(["operator"]) // e.g., ["operator", "admin"]
  active       Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentBlock {
  id      String   @id @default(cuid())
  key     String   // e.g., "homepage.hero", "homepage.usp_section"
  locale  String   // "ar-MA" or "fr-MA"
  content Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

// A generic key-value store for settings like shipping rules, etc.
model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
